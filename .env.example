# Supabase — must live at the PROJECT ROOT (not inside src/)
# Get these from https://app.supabase.com → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — required for admin panel (products, orders, uploads)
# NEVER prefix with VITE_ — it would ship to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin portal (/pen) — same email as Supabase Authentication → Users
# Only these emails can use the dashboard after login (comma-separated for multiple)
ADMIN_EMAILS=your-supabase-admin-email@example.com

# Public site URL — used for SEO canonical links, sitemap, and social previews
# Example: https://shopalbie.com
VITE_SITE_URL=https://your-domain.com

